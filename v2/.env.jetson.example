# ITIPS V2.1 — Jetson production .env template.
#
# On the Jetson:   cp .env.jetson.example .env   then fill the REQUIRED values.
# Jetson defaults (GPU on, prod mode, 8 GB-safe) are already set below.
# NEVER commit the filled-in .env — it holds camera passwords + the HMAC key.
# Run with:  make up-jetson   (uses docker-compose.jetson.yml).

# ── Tenancy — REQUIRED (get from the platform team at provisioning) ──
ITIPS_SITE_ID=
ITIPS_OPERATOR_ID=
ITIPS_DEVICE_ID=
ITIPS_SITE_LATITUDE=
ITIPS_SITE_LONGITUDE=
ITIPS_SITE_STATE=
ITIPS_SITE_GEOPOLITICAL_ZONE=

# ── Cameras (RTSP) — REQUIRED, up to 4. Leave unused slots empty. ──
# Format: rtsp://admin:PASSWORD@CAM_IP:554/cam/realmonitor?channel=1&subtype=0
ITIPS_CAMERA_1_RTSP=
ITIPS_CAMERA_2_RTSP=
ITIPS_CAMERA_3_RTSP=
ITIPS_CAMERA_4_RTSP=

# ── Dahua client knobs ──
ITIPS_DAHUA_WORKERS_GROUP=ITIPS_Workers
ITIPS_DAHUA_FACE_SIMILARITY=80
ITIPS_DAHUA_EVENT_COOLDOWN_S=1.5

# ── Sync Agent intake ──
ITIPS_INTAKE_DB_PATH=/opt/itips/var/intake.sqlite
ITIPS_INTAKE_MAX_AGE_DAYS=30

# ── Evidence ──
ITIPS_EVIDENCE_STORE_PATH=/opt/itips/evidence_store
ITIPS_PRE_EVENT_BUFFER_SECONDS=900
ITIPS_POST_EVENT_BUFFER_SECONDS=1800
# Stays libx265 (CPU) on Jetson: Tegra HW encode is GStreamer, not ffmpeg NVENC.
ITIPS_VIDEO_ENCODER=libx265
ITIPS_EVIDENCE_GRABBER_FPS=8

# ── ML / GPU (Jetson) ──
# GPU on: face + YOLO run on CUDA. Plate OCR (PaddleOCR) stays CPU by design.
ITIPS_USE_GPU=true
ITIPS_PLATE_FALLBACK_ENABLED=true
ITIPS_BEHAVIOR_FALLBACK_ENABLED=true
# Faster + lower RAM: after running
#   make build-jetson && docker compose -f docker-compose.yml \
#     -f docker-compose.jetson.yml run --rm itips ./scripts/export_yolo_tensorrt.sh
# uncomment to use the TensorRT engine:
#   ITIPS_BEHAVIOR_MODEL=/opt/itips/models/yolov8n.engine

# ── Incident lifecycle ──
ITIPS_INCIDENT_IDLE_TIMEOUT_SECONDS=15
# REQUIRED — 64 hex chars, generated once per device:  openssl rand -hex 32
ITIPS_DEVICE_HMAC_KEY=

# ── Threat evaluator (face-gated verdict engine) ──
ITIPS_THREAT_EVALUATOR_ENABLED=true
ITIPS_THREAT_EVALUATOR_WINDOW_S=15
ITIPS_THREAT_EVALUATOR_SAMPLE_S=1.0
ITIPS_THREAT_EVALUATOR_HOLDOFF_CLEAR_S=15
ITIPS_THREAT_EVALUATOR_ESCALATE_AFTER_S=3
ITIPS_THREAT_EVALUATOR_CLIP_PRE_S=15
ITIPS_THREAT_EVALUATOR_CLIP_POST_S=15

# ── API surfaces ──
ITIPS_PUBLIC_API_HOST=0.0.0.0
ITIPS_PUBLIC_API_PORT=5050
ITIPS_INBOUND_API_HOST=0.0.0.0
ITIPS_INBOUND_API_PORT=8443
# REQUIRED — bearer token issued by the backend at device provisioning.
ITIPS_INBOUND_TOKEN=
ITIPS_INBOUND_TLS_CERT=
ITIPS_INBOUND_TLS_KEY=

# ── Runtime mode ──
ITIPS_MODE=prod
ITIPS_LOG_LEVEL=INFO

# ── AX PRO hub listener (leave HOST empty to disable) ──
ITIPS_AXPRO_HOST=
ITIPS_AXPRO_USERNAME=
ITIPS_AXPRO_PASSWORD=
ITIPS_AXPRO_POLL_MS=500

# ── OpenAI validator (optional second-opinion layer; off by default) ──
ITIPS_OPENAI_ENABLED=false
ITIPS_OPENAI_API_KEY=
ITIPS_OPENAI_MODEL=gpt-4o-mini
ITIPS_OPENAI_MAX_TOKENS_PER_HOUR=100000
ITIPS_OPENAI_PROMPTS_PATH=config/prompts.yaml
ITIPS_OPENAI_TIMEOUT_S=30

# ── Outbound webhooks ──
ITIPS_WEBHOOKS_ENABLED=true
ITIPS_WEBHOOKS_DB_PATH=/opt/itips/var/webhooks.sqlite
ITIPS_WEBHOOKS_TIMEOUT_S=10
ITIPS_WEBHOOKS_WORKERS=2
ITIPS_WEBHOOKS_MAX_QUEUE=1000

# Copy to `.env` and fill in real values. `.env` is gitignored.
# `.env.example` is the only env file that lives in the repo.

# ─────────────────────────────────────────────────────────────
# Tenancy — REQUIRED in production
# These IDs are stamped onto every record the Sync Agent forwards to the
# national database. Get them from the platform team during provisioning.
# ─────────────────────────────────────────────────────────────
ITIPS_SITE_ID=
ITIPS_OPERATOR_ID=
ITIPS_DEVICE_ID=
ITIPS_SITE_LATITUDE=
ITIPS_SITE_LONGITUDE=
ITIPS_SITE_STATE=
ITIPS_SITE_GEOPOLITICAL_ZONE=

# ─────────────────────────────────────────────────────────────
# Cameras (RTSP) — up to 4. Leave unused slots empty.
# ─────────────────────────────────────────────────────────────
ITIPS_CAMERA_1_RTSP=
ITIPS_CAMERA_2_RTSP=
ITIPS_CAMERA_3_RTSP=
ITIPS_CAMERA_4_RTSP=
ITIPS_CAMERA_MAX_FRAME_WIDTH=1920

# Worker mode. "streaming" (default) = continuous RTSP decode + 24/7
# inference (Orin NX / AGX). "event_driven" = Dahua eventManager.cgi
# subscription + on-event snapshot inference (Orin Nano).
ITIPS_CAMERA_MODE=streaming

# ─────────────────────────────────────────────────────────────
# AX PRO sensor hub
# ─────────────────────────────────────────────────────────────
AXPRO_HOST=
ITIPS_AX_PRO_PORT=80
AXPRO_USERNAME=
AXPRO_PASSWORD=

# ─────────────────────────────────────────────────────────────
# PTZ cameras (ONVIF). One block per camera that we drive directly.
# ─────────────────────────────────────────────────────────────
ITIPS_PTZ_1_ENABLED=false
ITIPS_PTZ_1_IP=
ITIPS_PTZ_1_PORT=80
ITIPS_PTZ_1_USER=admin
ITIPS_PTZ_1_PASS=

ITIPS_PTZ_4_ENABLED=false
ITIPS_PTZ_4_IP=
ITIPS_PTZ_4_PORT=80
ITIPS_PTZ_4_USER=admin
ITIPS_PTZ_4_PASS=

# Sensor zone (AX PRO zone_id) → (camera_id, preset_name). JSON string.
# Example: {"1":{"camera_id":1,"preset":"Gate View"}}
ITIPS_SENSOR_ZONE_PTZ_MAP=

# ─────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────
ITIPS_YOLO_MODEL=/opt/itips/models/yolo11n.engine
ITIPS_YOLO_FALLBACK_MODEL=yolo11n.pt
ITIPS_YOLO_IMG_SIZE=640
ITIPS_YOLO_CONFIDENCE=0.35
ITIPS_YOLO_IOU=0.5

# YOLO backend. "ultralytics" (default) uses PyTorch + ByteTrack tracker.
# "onnx" runs the model through onnxruntime-gpu only (no torch), saves
# ~2 GB RAM on Jetson L4T but loses the built-in tracker. See
# docs/jetson-memory.md. Convert .pt to .onnx once via
# scripts/export_yolo_onnx.sh before switching to onnx.
ITIPS_YOLO_BACKEND=ultralytics

ITIPS_INSIGHTFACE_PACK=buffalo_l
ITIPS_INSIGHTFACE_DET_SIZE=640

# Plate Recognizer Stream API (on-premise container).
ITIPS_PLATE_RECOGNIZER_URL=http://plate-recognizer:8080/v1/plate-reader/
ITIPS_PLATE_RECOGNIZER_TOKEN=

# ─────────────────────────────────────────────────────────────
# Sync Agent intake (local SQLite priority queue)
# ─────────────────────────────────────────────────────────────
ITIPS_INTAKE_DB_PATH=/opt/itips/var/intake.sqlite
ITIPS_INTAKE_MAX_AGE_DAYS=30

# ─────────────────────────────────────────────────────────────
# Zones + PTZ presets
# Seed = checked-in defaults; runtime = dashboard-edited overrides.
# ─────────────────────────────────────────────────────────────
ITIPS_ZONES_SEED_PATH=config/zones.example.json
ITIPS_ZONES_RUNTIME_PATH=/opt/itips/var/zones.json
ITIPS_PRESETS_CONFIG_PATH=config/presets.example.json

# ─────────────────────────────────────────────────────────────
# Evidence
# ─────────────────────────────────────────────────────────────
ITIPS_EVIDENCE_STORE_PATH=/opt/itips/evidence_store
ITIPS_PRE_EVENT_BUFFER_SECONDS=60
ITIPS_POST_EVENT_BUFFER_SECONDS=120

# ─────────────────────────────────────────────────────────────
# Two-stage incidents (false-alarm reduction)
# Behaviour events open PRELIMINARY; promotion to CONFIRMED requires
# either dwell, a sensor signal within the window, or a face match.
# Incidents idle longer than the timeout are finalized and signed.
# ─────────────────────────────────────────────────────────────
ITIPS_INCIDENT_CONFIRMATION_DWELL_SECONDS=5
ITIPS_INCIDENT_CONFIRMATION_WINDOW_SECONDS=30
ITIPS_INCIDENT_IDLE_TIMEOUT_SECONDS=15
# 64-hex-char HMAC key (32 bytes). Generated once per device at provisioning.
# Never commit a real value. Treat as a secret on par with a TLS private key.
ITIPS_DEVICE_HMAC_KEY=

# ─────────────────────────────────────────────────────────────
# API surfaces
# ─────────────────────────────────────────────────────────────
ITIPS_PUBLIC_API_HOST=0.0.0.0
ITIPS_PUBLIC_API_PORT=5050

ITIPS_INBOUND_API_HOST=0.0.0.0
ITIPS_INBOUND_API_PORT=8443
ITIPS_INBOUND_TOKEN=
# When mTLS is enabled in Phase 1, populate these paths instead.
ITIPS_INBOUND_TLS_CERT=
ITIPS_INBOUND_TLS_KEY=
ITIPS_INBOUND_TLS_CA=

# ─────────────────────────────────────────────────────────────
# Behaviour thresholds (sensible defaults; tunable per site via B2)
# ─────────────────────────────────────────────────────────────
ITIPS_LOITERING_SECONDS=120
ITIPS_LOITERING_GATE_SECONDS=30
ITIPS_GENERATOR_TAMPERING_PERSON_COUNT=2
ITIPS_FACE_MATCH_THRESHOLD=0.6
ITIPS_FACE_MARGIN_THRESHOLD=0.05
ITIPS_FACE_AUTH_TTL_SECONDS=120

# ─────────────────────────────────────────────────────────────
# Runtime mode
#   prod   — real Jetson, real cameras, real AX PRO
#   sim    — laptop, MediaMTX-backed RTSP, CPU-only inference allowed
#   dev    — laptop or Jetson with feature flags relaxed
# ─────────────────────────────────────────────────────────────
ITIPS_MODE=prod
ITIPS_SIMULATE=false
ITIPS_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Feature flags — operator-only UIs disabled by default in prod
# ─────────────────────────────────────────────────────────────
ITIPS_ENABLE_ZONE_EDITOR=false
ITIPS_ENABLE_FACE_ENROLLMENT=false
ITIPS_ENABLE_TEST_ENDPOINTS=false

# Copy to `.env` and fill in real values. `.env` is gitignored.
# `.env.example` is the only env file that lives in the repo.

# ─────────────────────────────────────────────────────────────
# Tenancy — REQUIRED in production
# These IDs are stamped onto every record the Sync Agent forwards to the
# national database. Get them from the platform team during provisioning.
# ─────────────────────────────────────────────────────────────
ITIPS_SITE_ID=
ITIPS_OPERATOR_ID=
ITIPS_DEVICE_ID=
ITIPS_SITE_LATITUDE=
ITIPS_SITE_LONGITUDE=
ITIPS_SITE_STATE=
ITIPS_SITE_GEOPOLITICAL_ZONE=

# ─────────────────────────────────────────────────────────────
# Cameras (RTSP) — up to 4. Leave unused slots empty.
# The HTTP credentials are parsed from the RTSP URL; one knob per camera.
# ─────────────────────────────────────────────────────────────
ITIPS_CAMERA_1_RTSP=
ITIPS_CAMERA_2_RTSP=
ITIPS_CAMERA_3_RTSP=
ITIPS_CAMERA_4_RTSP=

# ─────────────────────────────────────────────────────────────
# Dahua client knobs
# ─────────────────────────────────────────────────────────────
ITIPS_DAHUA_WORKERS_GROUP=ITIPS_Workers
ITIPS_DAHUA_FACE_SIMILARITY=80
ITIPS_DAHUA_EVENT_COOLDOWN_S=1.5

# Per-camera PTZ channel override. Defaults to 1; auto-detect tries
# channel 2 if channel 1 has no PTZ. Pin this for multi-sensor models
# where the PTZ head is on a non-standard channel and you see
# "Error: Bad Channel" in the PTZ logs.
#   ITIPS_PTZ_1_CHANNEL=2

# ─────────────────────────────────────────────────────────────
# Sync Agent intake (local SQLite priority queue)
# ─────────────────────────────────────────────────────────────
ITIPS_INTAKE_DB_PATH=/opt/itips/var/intake.sqlite
ITIPS_INTAKE_MAX_AGE_DAYS=30

# ─────────────────────────────────────────────────────────────
# Evidence
# ─────────────────────────────────────────────────────────────
ITIPS_EVIDENCE_STORE_PATH=/opt/itips/evidence_store
# PRD §2.3 mandates 15-min pre + 30-min post. Shrink for dev only.
ITIPS_PRE_EVENT_BUFFER_SECONDS=900
ITIPS_POST_EVENT_BUFFER_SECONDS=1800
# Video encoder for evidence clips. libx265 (CPU) works everywhere incl.
# the Jetson; *_nvenc target discrete NVIDIA GPUs only (Tegra HW encode is
# GStreamer, not ffmpeg NVENC). libx264 for browser-playable clips.
ITIPS_VIDEO_ENCODER=libx265
# Continuous RTSP grabber FPS. The Dahua-native pipeline only sees frames
# when an event JPEG lands; without this background grabber the pre-event
# ring buffer is empty and saved Video_cam{N}_*.mp4 files come out blank.
# 8 fps is a good default — bump if motion looks choppy, drop if CPU is hot.
ITIPS_EVIDENCE_GRABBER_FPS=8

# ─────────────────────────────────────────────────────────────
# ML fallback layer (Jetson GPU + per-engine toggles)
#
# ITIPS_USE_GPU: leave false on Mac/CPU (engines pick CPU-only providers
# and skip the CUDA probe that otherwise logs misses looking like errors).
# The Jetson compose override sets it true.
#
# The face engine is always loaded (recognition is ML-only; the threat
# evaluator needs it). The plate/behavior fallbacks are per-camera — turn
# off one a site never uses (e.g. plate OCR with no vehicle lane) to cut
# RAM on the Jetson's 8 GB unified memory.
# ─────────────────────────────────────────────────────────────
ITIPS_USE_GPU=false
ITIPS_PLATE_FALLBACK_ENABLED=true
ITIPS_BEHAVIOR_FALLBACK_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Incident lifecycle
#
# Idle timeout is how long the alert engine waits for additional events
# on a camera before finalising the incident package. Promotion from
# preliminary → confirmed comes from explicit verdict signals
# (face_intruder, fire, smoke) — there's no longer a time-based promotion.
# ─────────────────────────────────────────────────────────────
ITIPS_INCIDENT_IDLE_TIMEOUT_SECONDS=15
# 64-hex-char HMAC key (32 bytes). Generated once per device at provisioning.
ITIPS_DEVICE_HMAC_KEY=

# ─────────────────────────────────────────────────────────────
# Threat evaluator (multi-frame face-gated verdict engine)
#
# Every primary trigger — camera line-cross, region intrusion, face
# event, AX PRO sensor activation — opens or extends a per-camera
# decision window. The evaluator samples snapshots during the window
# and runs the face engine on each. One of three verdicts closes it:
#
#   * AUTHORIZED — face matched an enrolled person. No alarm.
#   * INTRUDER   — face seen but never matched. Alarm if hub armed.
#   * UNCERTAIN  — no face ever visible (back-to-camera). No alarm.
#
# Requires the ML extras (face engine). When face engine is missing,
# event handlers fall back to the legacy direct-to-incident path.
# ─────────────────────────────────────────────────────────────
ITIPS_THREAT_EVALUATOR_ENABLED=true
# Decision window length in seconds. Longer = more chances to catch the
# worker's face; shorter = faster INTRUDER verdict on actual breaches.
ITIPS_THREAT_EVALUATOR_WINDOW_S=15
# How often the worker samples a fresh snapshot per camera, in seconds.
ITIPS_THREAT_EVALUATOR_SAMPLE_S=1.0
# After an AUTHORIZED verdict, stop re-evaluating that camera until its
# frame has been clear of faces for this many seconds — so a recognised
# worker standing in view isn't re-checked (and re-prompted to show their
# face) on every event. Re-arms only once the worker has actually left.
ITIPS_THREAT_EVALUATOR_HOLDOFF_CLEAR_S=15
# Escalate to INTRUDER early once an unrecognised person keeps dwelling in
# the zone this long (no enrolled worker matched) — even if their face was
# never captured. A matched worker closes the window first, so only
# strangers escalate. 0 disables early escalation.
ITIPS_THREAT_EVALUATOR_ESCALATE_AFTER_S=3
# On an UNCERTAIN verdict (someone present but no usable face), cut an
# evidence clip this many seconds before/after they entered — pulled from
# the recorder's pre-event ring buffer — and attach it to the investigation.
ITIPS_THREAT_EVALUATOR_CLIP_PRE_S=15
ITIPS_THREAT_EVALUATOR_CLIP_POST_S=15

# ─────────────────────────────────────────────────────────────
# API surfaces
# ─────────────────────────────────────────────────────────────
ITIPS_PUBLIC_API_HOST=0.0.0.0
ITIPS_PUBLIC_API_PORT=5050

ITIPS_INBOUND_API_HOST=0.0.0.0
ITIPS_INBOUND_API_PORT=8443
ITIPS_INBOUND_TOKEN=
ITIPS_INBOUND_TLS_CERT=
ITIPS_INBOUND_TLS_KEY=

# ─────────────────────────────────────────────────────────────
# Runtime mode
#   prod   — real Jetson, real cameras
#   sim    — laptop, MediaMTX-backed RTSP
#   dev    — laptop or Jetson with feature flags relaxed
# ─────────────────────────────────────────────────────────────
ITIPS_MODE=prod
ITIPS_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# AX PRO Hub listener (Phase 2 sensor pipeline)
#
# When all three credentials are set, the Jetson polls the
# Hikvision AX PRO hub every ITIPS_AXPRO_POLL_MS ms for
# zone-alarm rising edges and dispatches each one through the
# SensorDispatcher (pan PTZ → snapshot → face validate).
#
# Leave ITIPS_AXPRO_HOST empty to disable the listener — the
# dashboard's Simulate trigger button still drives the full
# pipeline end-to-end, so you can develop without a real hub.
#
# IMPORTANT: legacy AXPRO_HOST / AXPRO_USERNAME / AXPRO_PASSWORD
# (no ITIPS_ prefix) are NOT read. Rename to ITIPS_AXPRO_*.
# ─────────────────────────────────────────────────────────────
ITIPS_AXPRO_HOST=
ITIPS_AXPRO_USERNAME=
ITIPS_AXPRO_PASSWORD=
ITIPS_AXPRO_POLL_MS=500

# ─────────────────────────────────────────────────────────────
# OpenAI Validator (second-opinion layer for ambiguous alerts)
#
# When enabled, ambiguous fallback alerts (face_intruder where the
# local match is weak, behavior intrusion/loitering/line_crossing
# where YOLO confidence is mid-band, and every sensor_unverified
# event) are routed through a vision model. The model returns a
# structured verdict that can suppress false positives, decorate
# alerts with NLP descriptions, or auto-escalate fire / smoke /
# weapon detections regardless of original trigger.
#
# Token discipline:
#   * Confidence-banded gating per scenario (see config/prompts.yaml)
#   * Per-zone cooldown re-uses verdicts for ~30s
#   * Hourly cap kills further calls when budget exhausted
#   * Image downsampled to 768px longest edge before upload
#
# Leave ITIPS_OPENAI_ENABLED=false (or unset) to disable entirely.
# ─────────────────────────────────────────────────────────────
ITIPS_OPENAI_ENABLED=false
ITIPS_OPENAI_API_KEY=
ITIPS_OPENAI_MODEL=gpt-4o-mini
ITIPS_OPENAI_MAX_TOKENS_PER_HOUR=100000
ITIPS_OPENAI_PROMPTS_PATH=config/prompts.yaml
# Per-call timeout (seconds). Vision calls can spike — 30s is a safe baseline,
# raise if you see frequent "Request timed out" warnings on slow links.
ITIPS_OPENAI_TIMEOUT_S=30

# ─────────────────────────────────────────────────────────────
# Outbound webhooks (itips/webhooks/)
#
# Push alerts, validator verdicts and sensor events to subscriber
# URLs instead of forcing consumers to poll. See docs/WEBHOOKS.md
# for the event payload schema and HMAC verification details.
# Subscriber CRUD lives on /api/webhooks/* — runtime, no restart needed.
# ─────────────────────────────────────────────────────────────
ITIPS_WEBHOOKS_ENABLED=true
ITIPS_WEBHOOKS_DB_PATH=/opt/itips/var/webhooks.sqlite
ITIPS_WEBHOOKS_TIMEOUT_S=10
ITIPS_WEBHOOKS_WORKERS=2
ITIPS_WEBHOOKS_MAX_QUEUE=1000

# Auto-trigger the AX PRO hub siren whenever an incident transitions to
# `confirmed` (see PRD §3.3 Stage 3). Off by default so a dev
# environment doesn't blast a live tower on every test event. Only flip
# on at the actual production site.
#   ITIPS_AXPRO_AUTO_SIREN=true
#   ITIPS_AXPRO_AUTO_SIREN_SUBSYS=1